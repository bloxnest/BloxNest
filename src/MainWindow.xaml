<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BloxNest"
    Width="472"
    SizeToContent="Height"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Foreground="#EEF1E9"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!-- The window draws its own frame and shadow (16 px margin) so it can fade and
         scale when it opens, closes or goes to the hidden icons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="56"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Title-bar buttons: the hover colour (Background) fades in, the icon dips on click -->
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2A3027"/>
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0"/>
                            <ContentPresenter
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.82" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#EEF1E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="CloseCaptionButtonStyle"
            TargetType="{x:Type Button}"
            BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Background" Value="#C83E45"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One continuous count selector: hover and selection fade, tiles press in on click -->
        <Style x:Key="CountSegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid x:Name="SegmentRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border x:Name="HoverFill" Background="#30372C" CornerRadius="6" Opacity="0"/>
                            <Border x:Name="SelectedFill" Background="#E6EBDE" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EEF1E9"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#171A16"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentRoot" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Background remains owned by the button, including runtime red.
             Content inherits Foreground so the confirmation state can use white.
             Hover brightens, click presses the button in and it springs back. -->
        <Style x:Key="LaunchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#17200C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LaunchRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>

                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>
                            <Border x:Name="LaunchOverlay" Background="#FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressOverlay" Background="#000000" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LaunchRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PressOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LaunchRoot" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="BackButtonStyle"
            TargetType="{x:Type Button}"
            BasedOn="{StaticResource LaunchButtonStyle}">
            <Setter Property="Background" Value="#21261E"/>
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="BorderBrush" Value="#333B2D"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="AboutBodyStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#A3AB9C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="AboutHeadingStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Options: a row of text with an on/off switch on the right -->
        <Style x:Key="ToggleRowStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <Border
                                x:Name="Track"
                                Grid.Column="1"
                                Width="40"
                                Height="22"
                                CornerRadius="11"
                                VerticalAlignment="Center"
                                BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#21261E"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#3A4334"/>
                                </Border.BorderBrush>
                                <Border
                                    x:Name="Knob"
                                    Width="14"
                                    Height="14"
                                    Margin="3,0,0,0"
                                    CornerRadius="7"
                                    HorizontalAlignment="Left"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <SolidColorBrush Color="#A3AB9C"/>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Knob grows a little on hover and slides + recolours when switched -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="18" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#D5F478" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#D5F478" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#171A16" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#21261E" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#A3AB9C" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#EEF1E9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="OptionHintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AboutBodyStyle}">
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SmallSegmentStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource CountSegmentStyle}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Slim dark scrollbar: a thin rounded bar that widens on hover and turns lime while dragged -->
        <Style x:Key="SlimThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar" Width="4" CornerRadius="3" HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#3A4334"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="6" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#5C6852" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width" To="4" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#D5F478" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A4334" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimPageStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimPageStyle}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimPageStyle}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Starts invisible and slightly small; code fades and scales it in. -->
    <Grid x:Name="WindowRoot" Margin="16" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Border CornerRadius="10" Background="#171A16" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border
            CornerRadius="10"
            Background="#171A16"
            BorderBrush="#2B3228"
            BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled">

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The unoccupied caption area remains draggable. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Text="BloxNest / MULTI-WINDOW"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#929C89"
                IsHitTestVisible="False"/>

            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                Style="{StaticResource CaptionButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Content="&#xE713;"
                ToolTip="Options"
                AutomationProperties.Name="Options"/>

            <Button
                x:Name="AboutButton"
                Grid.Column="2"
                Style="{StaticResource CaptionButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Content="&#xE946;"
                ToolTip="About and privacy"
                AutomationProperties.Name="About and privacy"/>

            <Button
                x:Name="MinButton"
                Grid.Column="3"
                Style="{StaticResource CaptionButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Content="&#xE921;"
                ToolTip="Minimize"
                AutomationProperties.Name="Minimize"/>

            <Button
                x:Name="CloseButton"
                Grid.Column="4"
                Style="{StaticResource CloseCaptionButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Content="&#xE8BB;"
                ToolTip="Close"
                AutomationProperties.Name="Close"/>
        </Grid>

        <Border Grid.Row="1" Padding="24,14,24,24">
            <Grid>

                <!-- C# switches this panel and AboutPanel between
                     Visible and Collapsed. -->
                <StackPanel x:Name="MainPanel" Visibility="Visible">

                    <StackPanel Orientation="Horizontal">
                        <Viewbox
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">

                            <!-- Copy of LogoArt: no shared visual instance. -->
                            <Canvas Width="256" Height="256">
                                <Path
                                    Fill="#A3AB9C"
                                    Data="M26,32 H184 V60 H54 V184 H26 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform
                                            Angle="15"
                                            CenterX="128"
                                            CenterY="128"/>
                                    </Path.RenderTransform>
                                </Path>

                                <Path
                                    Fill="#D5F478"
                                    Data="F0
                                          M72,72 H230 V224 H72 Z
                                          M102,124 H200 V194 H102 Z
                                          M96,92 H106 V102 H96 Z
                                          M116,92 H126 V102 H116 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform
                                            Angle="15"
                                            CenterX="128"
                                            CenterY="128"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <TextBlock
                            Text="BloxNest"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#EEF1E9"/>
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Open as many Roblox windows as you need."
                        FontSize="13"
                        Foreground="#A3AB9C"/>

                    <Grid Margin="0,28,0,10">
                        <TextBlock
                            Text="How many windows?"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#C8CFBF"/>
                        <!-- Code fills this, e.g. "Roblox 0.740 · up to date" -->
                        <TextBlock
                            x:Name="RobloxVersionText"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#7E8876"/>
                    </Grid>

                    <Border
                        Background="#21261E"
                        BorderBrush="#333B2D"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="3">

                        <UniformGrid
                            x:Name="Segments"
                            Rows="1"
                            Columns="6"
                            Height="50">

                            <RadioButton
                                Style="{StaticResource CountSegmentStyle}"
                                GroupName="WindowCount"
                                Tag="1"
                                Content="1"
                                AutomationProperties.Name="1 window"/>

                            <RadioButton
                                Style="{StaticResource CountSegmentStyle}"
                                GroupName="WindowCount"
                                Tag="2"
                                Content="2"
                                IsChecked="True"
                                AutomationProperties.Name="2 windows"/>

                            <RadioButton
                                Style="{StaticResource CountSegmentStyle}"
                                GroupName="WindowCount"
                                Tag="3"
                                Content="3"
                                AutomationProperties.Name="3 windows"/>

                            <RadioButton
                                Style="{StaticResource CountSegmentStyle}"
                                GroupName="WindowCount"
                                Tag="4"
                                Content="4"
                                AutomationProperties.Name="4 windows"/>

                            <RadioButton
                                Style="{StaticResource CountSegmentStyle}"
                                GroupName="WindowCount"
                                Tag="5"
                                Content="5"
                                AutomationProperties.Name="5 windows"/>

                            <!-- Type any number. Code highlights it like a
                                 selected segment while it holds a number. -->
                            <Grid Margin="2" ToolTip="Type any number from 1 to 20">
                                <Border
                                    x:Name="CustomSurface"
                                    Background="Transparent"
                                    CornerRadius="6"/>
                                <TextBlock
                                    x:Name="CustomHint"
                                    Text="Custom"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#A3AB9C"
                                    IsHitTestVisible="False"/>
                                <TextBox
                                    x:Name="CustomCount"
                                    MaxLength="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#EEF1E9"
                                    CaretBrush="#D5F478"
                                    SelectionBrush="#D5F478"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="Custom number of windows"/>
                            </Grid>
                        </UniformGrid>
                    </Border>

                    <Button
                        x:Name="StartButton"
                        Margin="0,16,0,0"
                        Background="#D5F478"
                        Style="{StaticResource LaunchButtonStyle}">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="StartIcon"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="16"
                                FontWeight="Normal"
                                Text="&#xE768;"/>

                            <TextBlock
                                x:Name="StartText"
                                VerticalAlignment="Center"
                                Text="Start"/>
                        </StackPanel>
                    </Button>

                    <!-- Plain status region, separate from the controls. -->
                    <Border
                        Margin="0,24,0,0"
                        Padding="0,18,0,18"
                        BorderBrush="#30372A"
                        BorderThickness="0,1,0,0">

                        <StackPanel>
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    x:Name="Dot"
                                    Width="7"
                                    Height="7"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#6B717C"/>

                                <TextBlock
                                    x:Name="StatusText"
                                    Grid.Column="1"
                                    Text="Ready when you are."
                                    Foreground="#C8CFBF"
                                    FontSize="13"
                                    LineHeight="20"
                                    TextWrapping="Wrap"/>
                            </Grid>

                            <Border
                                x:Name="ProgressWrap"
                                Height="3"
                                Margin="18,12,0,0"
                                Background="#30372A"
                                CornerRadius="1.5"
                                ClipToBounds="True"
                                Visibility="Collapsed">

                                <Border
                                    x:Name="ProgressFill"
                                    Background="#6D8BFF"
                                    CornerRadius="1.5"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="0,3,0,0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="#929C89"
                            Text="&#xE946;"/>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="#929C89"
                            LineHeight="18"
                            TextWrapping="Wrap"
                            Text="Use a different account in each window. Using the same account twice kicks you out."/>
                    </Grid>
                </StackPanel>

                <!-- About replaces the main content in the same window. -->
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed">

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BackButton"
                            Style="{StaticResource BackButtonStyle}"
                            Content="&#x2190; Back"
                            AutomationProperties.Name="Back to launcher"/>

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="ABOUT + PRIVACY"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#929C89"/>
                    </Grid>

                    <!-- Auto height for short content; scrolling caps the
                         view on smaller displays without a fixed Window height. -->
                    <ScrollViewer
                        MaxHeight="580"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">

                        <StackPanel Margin="0,0,8,0">

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Viewbox
                                    Width="64"
                                    Height="64"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    IsHitTestVisible="False">

                                    <!-- Export source for 48-256 px icons.
                                         All cutouts are genuinely transparent. -->
                                    <Canvas x:Name="LogoArt" Width="256" Height="256">
                                        <Path
                                            Fill="#A3AB9C"
                                            Data="M26,32 H184 V60 H54 V184 H26 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform
                                                    Angle="15"
                                                    CenterX="128"
                                                    CenterY="128"/>
                                            </Path.RenderTransform>
                                        </Path>

                                        <Path
                                            Fill="#D5F478"
                                            Data="F0
                                                  M72,72 H230 V224 H72 Z
                                                  M102,124 H200 V194 H102 Z
                                                  M96,92 H106 V102 H96 Z
                                                  M116,92 H126 V102 H116 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform
                                                    Angle="15"
                                                    CenterX="128"
                                                    CenterY="128"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="BloxNest"
                                        FontFamily="Segoe UI Variable Display, Segoe UI"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="#EEF1E9"/>

                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Text="Made by xRed1"
                                        FontSize="13"
                                        Foreground="#C8CFBF"/>

                                    <TextBlock
                                        x:Name="VersionText"
                                        Margin="0,5,0,0"
                                        Text="Version"
                                        FontSize="12"
                                        Foreground="#929C89"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Style="{StaticResource AboutBodyStyle}"
                                Text="A free, fan-made utility for playing on multiple accounts in separate Roblox windows."/>

                            <Border
                                Margin="0,20,0,0"
                                Padding="0,18,0,0"
                                BorderBrush="#30372A"
                                BorderThickness="0,1,0,0">

                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AboutHeadingStyle}"
                                        Text="Privacy"/>

                                    <TextBlock
                                        Style="{StaticResource AboutBodyStyle}"
                                        Text="The app does not collect, store or send any personal data. No accounts, passwords, cookies, analytics or tracking."/>

                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource AboutBodyStyle}"
                                        Text="It only connects to Roblox's own server, to check which Roblox version is newest. If yours is out of date, it runs the Roblox updater that's already on your PC, after checking it's signed by Roblox Corporation."/>

                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource AboutBodyStyle}"
                                        Text="It does not modify Roblox's files or inject anything into the game. It opens Roblox normally and stops Roblox's &quot;only one window&quot; check from closing the extra windows."/>

                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource AboutBodyStyle}"
                                        Text="Everything runs on your PC. The app doesn't download any files. The only file it saves is your options, in your AppData folder."/>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,20,0,0"
                                Padding="0,18,0,0"
                                BorderBrush="#30372A"
                                BorderThickness="0,1,0,0">

                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AboutHeadingStyle}"
                                        Text="Disclaimer"/>

                                    <TextBlock
                                        Style="{StaticResource AboutBodyStyle}"
                                        Text="Not affiliated with or endorsed by Roblox Corporation. Roblox is a trademark of Roblox Corporation. Use at your own risk; a Roblox update can stop it working."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- Options replace the main content the same way About does. -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="SettingsBackButton"
                            Style="{StaticResource BackButtonStyle}"
                            Content="&#x2190; Back"
                            AutomationProperties.Name="Back to launcher"/>

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="OPTIONS"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#929C89"/>
                    </Grid>

                    <CheckBox x:Name="OptTray" Style="{StaticResource ToggleRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Keep running in hidden icons"/>
                            <TextBlock Style="{StaticResource OptionHintStyle}"
                                       Text="Closing the window tucks BloxNest into the hidden icons on your taskbar."/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="OptUpdate" Style="{StaticResource ToggleRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Update Roblox before opening"/>
                            <TextBlock Style="{StaticResource OptionHintStyle}"
                                       Text="Every window runs the newest Roblox."/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="OptNotify" Style="{StaticResource ToggleRowStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Tell me when Roblox updates"/>
                            <TextBlock Style="{StaticResource OptionHintStyle}"
                                       Text="Checks every 30 minutes while BloxNest is running."/>
                        </StackPanel>
                    </CheckBox>

                    <Border
                        Margin="0,20,0,0"
                        Padding="0,18,0,0"
                        BorderBrush="#30372A"
                        BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Time between windows"/>
                            <TextBlock Style="{StaticResource OptionHintStyle}"
                                       Text="More time helps slower PCs open every window."/>

                            <Border
                                Margin="0,12,0,0"
                                Background="#21261E"
                                BorderBrush="#333B2D"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="3">
                                <UniformGrid x:Name="DelaySegments" Rows="1" Columns="3" Height="38">
                                    <RadioButton Style="{StaticResource SmallSegmentStyle}" GroupName="Delay" Tag="3" Content="3 sec"/>
                                    <RadioButton Style="{StaticResource SmallSegmentStyle}" GroupName="Delay" Tag="5" Content="5 sec" IsChecked="True"/>
                                    <RadioButton Style="{StaticResource SmallSegmentStyle}" GroupName="Delay" Tag="8" Content="8 sec"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,20,0,0"
                        Padding="0,18,0,0"
                        BorderBrush="#30372A"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}" Text="Roblox version"/>
                                <TextBlock x:Name="VersionDetailText" Style="{StaticResource OptionHintStyle}" Text="Checking..."/>
                            </StackPanel>
                            <Button
                                x:Name="CheckNowButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButtonStyle}"
                                Content="Check now"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Export-only source for 16-32 px icons.
             Two solid shapes; thicker frame, no tiny header cutouts.
             Make visible and measure/arrange off-screen before rendering.
             Keep collapsed during normal window layout. -->
        <Canvas
            x:Name="LogoSmall"
            Width="256"
            Height="256"
            Grid.Row="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            IsHitTestVisible="False">

            <Path
                Fill="#A3AB9C"
                Data="M26,32 H184 V64 H58 V184 H26 Z">
                <Path.RenderTransform>
                    <RotateTransform
                        Angle="15"
                        CenterX="128"
                        CenterY="128"/>
                </Path.RenderTransform>
            </Path>

            <Path
                Fill="#D5F478"
                Data="F0
                      M72,72 H230 V224 H72 Z
                      M108,128 H194 V188 H108 Z">
                <Path.RenderTransform>
                    <RotateTransform
                        Angle="15"
                        CenterX="128"
                        CenterY="128"/>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
        </Border>
    </Grid>
</Window>